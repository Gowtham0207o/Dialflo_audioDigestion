# ──────────────────────────────────────────────
# Environment Configuration
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# ── Server ──────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ── Model Configuration ────────────────────
MODEL_CACHE_DIR=./models
MODEL_DEVICE=cpu
# Options: cpu, cuda, mps (Apple Silicon)

# Gender classifier
GENDER_MODEL_NAME=speechbrain/spkrec-ecapa-voxceleb
GENDER_CONFIDENCE_THRESHOLD=0.6

# Age estimator
AGE_MODEL_NAME=audeering/wav2vec2-large-robust-12-ft-emotion-msp-dim
AGE_CONFIDENCE_THRESHOLD=0.5

# ── Audio Processing ───────────────────────
AUDIO_MAX_DURATION_SECONDS=30
AUDIO_TARGET_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE_MS=5000
AUDIO_MIN_SNR_DB=10.0

# ── Resilience ─────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30

# ── Observability ──────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
